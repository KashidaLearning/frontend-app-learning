/* ROWAD LEARNING COURSE CONTEXT */
.rowad-learning-course-context {
  position: relative;
  z-index: 2;
  width: 100%;
  background: #fff;
  border-bottom: 1px solid rgba(23, 53, 62, 0.12);
}

.rowad-learning-course-context__inner {
  display: flex;
  align-items: baseline;
  gap: 0.75rem;
  width: 100%;
  min-width: 0;
  padding: 0.75rem 1.5rem;
}

.rowad-learning-course-context__code {
  flex: 0 0 auto;
  color: #65757b;
  font-size: 0.8125rem;
  font-weight: 500;
  white-space: nowrap;
}

.rowad-learning-course-context__title {
  min-width: 0;
  overflow: hidden;
  color: #17353e;
  font-size: 1rem;
  font-weight: 700;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

[dir="rtl"] .rowad-learning-course-context__inner {
  text-align: right;
}

@media (max-width: 575.98px) {
  .rowad-learning-course-context__inner {
    align-items: flex-start;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.625rem 1rem;
  }

  .rowad-learning-course-context__title {
    width: 100%;
  }
}

/* ROWAD COURSEWARE LAYOUT - STEP 2 */

/*
 * Applied only to the Course tab. Other pages such as Progress,
 * Dates, Instructor, Discussions, and course Home remain unchanged.
 */
.rowad-courseware-page {
  flex: 1 0 auto;
  width: 100%;
  background-color: #f4f6f4;
}

/*
 * Make the courseware area wider than the default Bootstrap
 * container while preserving responsive side spacing.
 */
.rowad-courseware-shell {
  width: 100%;
  max-width: 1600px !important;
  margin-inline: auto;
  padding-inline: clamp(1rem, 3vw, 3.5rem);
  padding-bottom: 3rem;
}

/*
 * The main white rounded container from the target design.
 */
.rowad-courseware-card {
  width: 100%;
  min-width: 0;
  min-height: 36rem;
  padding: clamp(1.25rem, 2vw, 2rem);
  background-color: #fff;
  border: 1px solid #e3e8e5;
  border-radius: 1.5rem;
  box-shadow: 0 0.375rem 1.5rem rgba(23, 53, 62, 0.06);
}

/*
 * The breadcrumb, mobile outline trigger, chat and discussion
 * controls remain functional inside the new container.
 */
.rowad-courseware-toolbar {
  width: 100%;
  min-width: 0;
  margin-top: 0 !important;
}

/*
 * Allow the course content column to shrink correctly instead of
 * forcing horizontal page scrolling.
 */
.rowad-courseware-card .sequence-container {
  width: 100%;
  min-width: 0;
  align-items: stretch;
}

.rowad-courseware-card .sequence {
  flex: 1 1 auto;
  width: auto !important;
  min-width: 0;
}

.rowad-courseware-card .unit-container {
  min-width: 0;
}

/*
 * Desktop two-column structure:
 *   outline = approximately 300px
 *   content = remaining available width
 *
 * Logical margin properties automatically support LTR and RTL.
 */
@media (min-width: 1200px) {
  .rowad-courseware-card .outline-sidebar-wrapper {
    flex: 0 0 18.75rem;
    width: 18.75rem;
    max-width: 18.75rem;
    margin: 0 !important;
    margin-inline-end: 1.5rem !important;
  }

  .rowad-courseware-card .outline-sidebar {
    width: 100%;
    min-width: 0;
  }

  /*
   * When the outline is collapsed, retain only its compact trigger
   * and allow the content column to use the released space.
   */
  .rowad-courseware-card
    .sequence-container
    > .outline-sidebar-heading-wrapper.collapsed {
    flex: 0 0 auto;
    margin: 0 !important;
    margin-inline-end: 1.25rem !important;
    border-radius: 0.75rem;
  }
}

/*
 * Below desktop width Open edX keeps using its existing full-screen
 * outline tray. We only adjust the surrounding white container.
 */
@media (max-width: 1199.98px) {
  .rowad-courseware-shell {
    max-width: 100% !important;
    padding-inline: 1.25rem;
    padding-bottom: 2rem;
  }

  .rowad-courseware-card {
    min-height: 30rem;
    padding: 1.25rem;
    border-radius: 1.25rem;
  }

  .rowad-courseware-card .sequence-container {
    display: block !important;
  }
}

/*
 * Small phones: keep safe horizontal spacing and avoid overflow.
 */
@media (max-width: 575.98px) {
  .rowad-courseware-page {
    background-color: #f4f6f4;
  }

  .rowad-courseware-shell {
    padding-inline: 0.75rem;
    padding-bottom: 1.5rem;
  }

  .rowad-courseware-card {
    min-height: 24rem;
    padding: 1rem;
    border-radius: 1rem;
  }

  .rowad-courseware-toolbar {
    margin-bottom: 1rem !important;
  }
}

/* ROWAD UNIT NAVIGATION - FINAL */

:root {
  --rowad-unit-green: #0b4a40;
  --rowad-unit-green-hover: #063b34;
  --rowad-unit-orange: #f28b3c;
}

/* ==========================================================
   SHARED TOP AND BOTTOM NAVIGATION
   ========================================================== */

.top-unit-navigation,
.unit-navigation {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 0.5rem !important;
}

.top-unit-navigation {
  flex: 0 0 auto !important;
  margin: 0 !important;
}

.unit-navigation {
  width: fit-content !important;
  margin: 1.75rem auto 0 !important;
}

/* Apply identical styling to all four navigation buttons. */
.top-unit-navigation .previous-button,
.top-unit-navigation .next-button,
.unit-navigation .previous-button,
.unit-navigation .next-button {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;

  flex: 0 0 2.25rem !important;
  box-sizing: border-box !important;

  width: 2.25rem !important;
  min-width: 2.25rem !important;
  max-width: 2.25rem !important;

  height: 2.25rem !important;
  min-height: 2.25rem !important;
  max-height: 2.25rem !important;

  margin: 0 !important;
  padding: 0 !important;

  overflow: hidden !important;

  background-color: var(--rowad-unit-green) !important;
  border: 1px solid var(--rowad-unit-green) !important;
  border-radius: 0.5rem !important;
  box-shadow: none !important;

  color: #fff !important;
  font-size: 0 !important;
  line-height: 0 !important;
  text-decoration: none !important;

  transition:
    background-color 160ms ease,
    border-color 160ms ease,
    transform 160ms ease !important;
}

.top-unit-navigation .previous-button:hover,
.top-unit-navigation .next-button:hover,
.unit-navigation .previous-button:hover,
.unit-navigation .next-button:hover {
  background-color: var(--rowad-unit-green-hover) !important;
  border-color: var(--rowad-unit-green-hover) !important;
  color: #fff !important;
  transform: translateY(-1px);
}

.top-unit-navigation .previous-button:focus,
.top-unit-navigation .next-button:focus,
.unit-navigation .previous-button:focus,
.unit-navigation .next-button:focus {
  outline: 3px solid rgba(242, 139, 60, 0.35) !important;
  outline-offset: 2px !important;
  box-shadow: none !important;
}

/* Remove Paragon icon spacing. */
.top-unit-navigation .btn-icon-before,
.top-unit-navigation .btn-icon-after,
.unit-navigation .btn-icon-before,
.unit-navigation .btn-icon-after {
  margin: 0 !important;
}

/* White centered arrow icons. */
.top-unit-navigation svg,
.unit-navigation svg,
.top-unit-navigation .pgn__icon,
.unit-navigation .pgn__icon {
  display: block !important;
  flex: 0 0 1.125rem !important;

  width: 1.125rem !important;
  height: 1.125rem !important;

  margin: 0 !important;

  color: #fff !important;
  fill: currentColor !important;
  font-size: 1.125rem !important;
}

/* Remove text and effort-estimate layout from bottom buttons. */
.unit-navigation .previous-button,
.unit-navigation .next-button {
  white-space: nowrap !important;
}

.unit-navigation .unit-navigation-effort-estimate {
  display: contents !important;
}

/* Disabled first/last-unit controls. */
.top-unit-navigation .previous-button:disabled,
.top-unit-navigation .next-button:disabled,
.unit-navigation .previous-button:disabled,
.unit-navigation .next-button:disabled,
.top-unit-navigation [aria-disabled="true"],
.unit-navigation [aria-disabled="true"] {
  background-color: #9caaa7 !important;
  border-color: #9caaa7 !important;
  color: #fff !important;
  cursor: not-allowed !important;
  opacity: 0.65 !important;
  transform: none !important;
}

/* ==========================================================
   COLLAPSED COURSE-OUTLINE TOGGLE
   ========================================================== */

/*
 * The wrapper is removed from the flex-column calculation.
 * This lets the white unit card use the available width and places
 * the toggle inside the card beside the unit title.
 */
.sequence-container {
  position: relative !important;
}

.sequence-container > .sequence {
  flex: 1 1 100% !important;
  width: 100% !important;
  min-width: 0 !important;
}

.sequence-container
  > .outline-sidebar-heading-wrapper.collapsed {
  position: absolute !important;
  z-index: 5 !important;

  inset-inline-start: 1.25rem !important;
  inset-inline-end: auto !important;
  top: 1.75rem !important;

  display: flex !important;
  align-items: center !important;
  justify-content: center !important;

  flex: none !important;
  box-sizing: border-box !important;

  width: 2.25rem !important;
  min-width: 2.25rem !important;
  max-width: 2.25rem !important;

  height: 2.25rem !important;
  min-height: 2.25rem !important;
  max-height: 2.25rem !important;

  margin: 0 !important;
  padding: 0 !important;

  overflow: hidden !important;

  background-color: var(--rowad-unit-green) !important;
  border: 1px solid var(--rowad-unit-green) !important;
  border-radius: 0.5rem !important;
  box-shadow: none !important;
}

/*
 * On wide screens, place the toggle immediately beside the centered
 * unit-title/content column instead of against the outside border.
 */
@media (min-width: 1280px) {
  .sequence-container
    > .outline-sidebar-heading-wrapper.collapsed {
    inset-inline-start:
      calc((100% - 64rem) / 2 - 2.375rem) !important;
  }
}

.sequence-container
  > .outline-sidebar-heading-wrapper.collapsed
  button,
.sequence-container
  > .outline-sidebar-heading-wrapper.collapsed
  .btn {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;

  box-sizing: border-box !important;
  width: 100% !important;
  min-width: 100% !important;
  height: 100% !important;
  min-height: 100% !important;

  margin: 0 !important;
  padding: 0 !important;

  background: transparent !important;
  border: 0 !important;
  border-radius: inherit !important;
  box-shadow: none !important;
  color: #fff !important;
}

.sequence-container
  > .outline-sidebar-heading-wrapper.collapsed:hover {
  background-color: var(--rowad-unit-green-hover) !important;
  border-color: var(--rowad-unit-green-hover) !important;
}

.sequence-container
  > .outline-sidebar-heading-wrapper.collapsed
  svg,
.sequence-container
  > .outline-sidebar-heading-wrapper.collapsed
  .pgn__icon {
  width: 1.125rem !important;
  height: 1.125rem !important;
  margin: 0 !important;

  color: #fff !important;
  fill: currentColor !important;
}

/* Prevent the old LTR transform from flipping the entire green button. */
[dir="ltr"]
  .outline-sidebar-heading-wrapper.collapsed,
[dir="rtl"]
  .outline-sidebar-heading-wrapper.collapsed {
  transform: none !important;
}

/* ==========================================================
   TABLET AND MOBILE
   ========================================================== */

@media (max-width: 1199.98px) {
  .sequence-container
    > .outline-sidebar-heading-wrapper.collapsed {
    position: static !important;
    width: 2.25rem !important;
